# ---------------------------------------------------------------------------
# TinyOps environment variables. Copy to .env.local for local development.
# Never commit real secrets. Variables WITHOUT the NEXT_PUBLIC_ prefix are
# server-only and must never be imported into client components.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects, invitation links, SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — `npx supabase status` prints local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS: used exclusively by webhooks/cron/contact form.
SUPABASE_SECRET_KEY=

# Stripe (Stage 8) — leave empty until configured; billing stays disabled.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cron (Stage 5) — shared secret for /api/cron/* routes.
CRON_SECRET=

# Optional: transactional email for invitations (Stage 6).
RESEND_API_KEY=
EMAIL_FROM="TinyOps <hello@example.com>"

# Optional: TinyOps AI provider (Stage 7). Leave empty to keep the assistant disabled.
AI_PROVIDER=
AI_API_KEY=
